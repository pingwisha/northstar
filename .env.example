# Names only. Copy to .env and fill in; .env is ignored by git.
# Cloudflare API token scopes (Account level): Cloudflare Pages Edit, D1 Edit,
# Workers Scripts Edit, Account Settings Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Google sign-in: OAuth client from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret that signs session cookies
SESSION_SECRET=
# Comma-separated Google emails allowed to sign in (no spaces)
ALLOWED_EMAILS=

# AI provider key for the server proxy (step 1.3)
GEMINI_API_KEY=
