{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		},
		"types": [
			"node",
			"$app/types",
			"./worker-configuration.d.ts"
		]
	},
	"include": [
		"src",
		"tests",
		"vite.config.ts",
		"playwright.config.ts",
		"e2e"
	]
}
